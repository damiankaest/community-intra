{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Identity": {
    "PublicAppUrl": "http://localhost:5173"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "CouchClash",
    "UseSsl": true
  },
  "ExternalLogin": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Discord": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "SteamApiKey": ""
  },
  "AiAssistant": {
    "ApiKey": "",
    "Model": "gpt-5.6",
    "Endpoint": "https://api.openai.com/v1/responses",
    "DraftLifetimeMinutes": 30
  },
  "CounterStrike": {
    "StorageRoot": "data/counter-strike",
    "MaximumDemoMegabytes": 512,
    "ParserTimeoutSeconds": 180,
    "AnalyzerExecutable": "csda",
    "QueueCapacity": 32,
    "SeedDemoData": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/backend-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
