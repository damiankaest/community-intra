APP_DOMAIN=community.example.com

# The deployment workflow fills these with the immutable Git commit tag.
# Keep the local defaults when building directly on the VM.
BACKEND_IMAGE=community-intranet-backend:local
FRONTEND_IMAGE=community-intranet-frontend:local

POSTGRES_DB=community_intranet
POSTGRES_USER=community_intranet
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_ISSUER=https://community.example.com
JWT_AUDIENCE=community-intranet
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
