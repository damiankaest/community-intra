APP_DOMAIN=community.example.com

# The deployment workflow fills these with the immutable Git commit tag.
# Keep the local defaults when building directly on the VM.
BACKEND_IMAGE=community-intranet-backend:local
FRONTEND_IMAGE=community-intranet-frontend:local

POSTGRES_DB=community_intranet
POSTGRES_USER=community_intranet
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_ISSUER=https://community.example.com
JWT_AUDIENCE=community-intranet
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
STEAM_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=CouchClash
SMTP_USE_SSL=true

OPENAI_API_KEY=replace-with-an-openai-api-key
AI_MODEL=gpt-5.6

CSDA_VERSION=1.10.5
CSDA_SHA256=5c972e016b90e08ae235e2ca8092423a1900868006a6cf0ceecd0f36f1be9cbe
CS2_MAXIMUM_DEMO_MEGABYTES=512
CS2_PARSER_TIMEOUT_SECONDS=180
CS2_QUEUE_CAPACITY=32

SPOTIFY_CLIENT_ID=replace-with-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-spotify-client-secret
